# /srv/apps/<app>/.env  (chmod 600, dueño deploy, solo en el VPS, nunca en git)
# Generar secretos con: openssl rand -hex 32

# Producción: device-reports / dreports / reportes.sismanager.cloud
# Staging:    device-reports-dev / dreports-dev / test-reportes.sismanager.cloud
APP_NAME=device-reports
APP_PREFIX=dreports
HOST=reportes.sismanager.cloud
TRAEFIK_ENTRYPOINT=websecure

# Lo actualiza deploy.sh en cada despliegue (sha corto del commit).
IMAGE_TAG=latest

# Token Bearer que usa el cliente DeviceReport.exe para subir reportes.
API_TOKEN=
MAX_UPLOAD_MB=50

# Panel web (solo lectura). Token de subida y acceso al panel están separados.
# ADMIN_USER / ADMIN_PASSWORD_HASH los escribe ./set-admin-password.sh (no editar a mano).
ADMIN_USER=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
SESSION_TTL_HOURS=12
